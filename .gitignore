# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# ── Django ────────────────────────────────────────────────────────────────────
# Local database and generated invoice PDFs: real data, kept on disk but not
# versioned. Back these up separately.
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/

# Secrets live in environment files. The root .env is tracked on purpose because
# it only sets USE_SQLITE, which the app needs; never put credentials in it.
.env.local
.env.*.local

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*

# ── Frontend build output ─────────────────────────────────────────────────────
frontend/dist/
/dist/

# ── WhatsApp sender ───────────────────────────────────────────────────────────
# Linked-device credentials. Committing these would let anyone send WhatsApp
# messages as this account, so they must never be versioned.
message-sender/.baileys_auth/
message-sender/.wwebjs_auth/
message-sender/.wwebjs_cache/

# Runtime artifacts regenerated by the sender
message-sender/.gateway-spawn.lock
message-sender/whatsapp-sender.log

# ── Logs / editor / OS ────────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
